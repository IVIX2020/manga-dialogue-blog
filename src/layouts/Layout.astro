---
interface Props {
  title: string;
  description?: string;
}

const { title, description = '漫画の吹き出し風・対話型解説ブログ' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Outfit:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | マンガ対話解説ラボ</title>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href={`${baseUrl}/`} class="site-logo">
          <span class="logo-icon">💬</span>
          <span class="logo-text">マンガ対話解説ラボ</span>
        </a>
        <nav class="site-nav">
          <a href={`${baseUrl}/`}>ホーム</a>
        </nav>
      </div>
    </header>

    <main class="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>&copy; 2026 マンガ対話解説ラボ - Minimal Dialogue Blog</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg-color: #fafafa;
    --text-color: #334155;
    --heading-color: #0f172a;
    --card-bg: #ffffff;
    
    /* Suppressed, muted dialogue colors */
    --takashi-bubble: #f1f5f9;
    --takashi-border: #cbd5e1;
    --sensei-bubble: #ffffff;
    --sensei-border: #e2e8f0;
    
    --shadow-subtle: 0 1px 3px 0 rgb(0 0 0 / 0.05);
    --shadow-hover: 0 4px 12px 0 rgb(0 0 0 / 0.08);
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Noto Sans JP', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-color);
    line-height: 1.85;
    letter-spacing: 0.025em;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Header - Clean Muted Slate */
  .site-header {
    background: #0f172a;
    color: #ffffff;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid #334155;
  }

  .header-inner {
    max-width: 820px;
    margin: 0 auto;
    padding: 0.9rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .site-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #ffffff;
    font-weight: 700;
    font-size: 1.15rem;
  }

  .logo-icon {
    font-size: 1.25rem;
  }

  .site-nav a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .site-nav a:hover {
    color: #ffffff;
  }

  /* Main Area */
  .main-content {
    flex: 1;
    max-width: 820px;
    width: 100%;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  /* Footer */
  .site-footer {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: #0f172a;
    color: #64748b;
    font-size: 0.825rem;
    margin-top: 5rem;
  }

  /* =========================================
     Chat View (Clean & Spacious Speech Bubbles)
     ========================================= */
  .chat-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin: 2.5rem 0;
    padding: 2rem 1.5rem;
    background: #ffffff;
    border-radius: 1rem;
    box-shadow: var(--shadow-subtle);
    border: 1px solid #e2e8f0;
  }

  .chat-message {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 88%;
    animation: fadeIn 0.25s ease-out;
  }

  .chat-message.left {
    align-self: flex-start;
  }

  .chat-message.right {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .chat-avatar-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 52px;
  }

  .chat-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    box-shadow: var(--shadow-subtle);
  }

  .chat-name {
    font-size: 0.725rem;
    font-weight: 500;
    color: #64748b;
    margin-top: 0.35rem;
  }

  .chat-content {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .chat-message.right .chat-content {
    align-items: flex-end;
  }

  .chat-bubble {
    position: relative;
    padding: 1rem 1.4rem;
    border-radius: 1rem;
    font-size: 0.95rem;
    line-height: 1.85;
    color: #334155;
    box-shadow: var(--shadow-subtle);
  }

  /* Left (Takashi) Bubble - Subtle Gray-Blue */
  .chat-message.left .chat-bubble {
    background-color: var(--takashi-bubble);
    border: 1px solid var(--takashi-border);
    border-top-left-radius: 0.2rem;
  }

  /* Right (Sensei) Bubble - Soft White */
  .chat-message.right .chat-bubble {
    background-color: var(--sensei-bubble);
    border: 1px solid var(--sensei-border);
    border-top-right-radius: 0.2rem;
  }

  .chat-time {
    font-size: 0.7rem;
    color: #94a3b8;
    padding: 0 0.2rem;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .chat-message {
      max-width: 96%;
      gap: 0.85rem;
    }
    .chat-container {
      padding: 1.25rem 0.85rem;
      gap: 1.5rem;
    }
    .chat-bubble {
      padding: 0.85rem 1.15rem;
      font-size: 0.925rem;
    }
  }
</style>
