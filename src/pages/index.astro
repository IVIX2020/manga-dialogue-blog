---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="ホーム">
  <section class="hero">
    <div class="hero-badge">対話型解説</div>
    <h1 class="hero-title">難しいテーマも、対話でシンプルに。</h1>
    <p class="hero-description">
      Zettelkastenの思考ノートを「タカシ」と「センセイ」の2人の対話を通じて、テンポよく紐解くミニマルな解説ブログです。
    </p>
  </section>

  <section class="posts-section">
    <h2 class="section-title">記事一覧</h2>
    <div class="posts-grid">
      {sortedPosts.map((post) => (
        <article class="post-card">
          <a href={`${baseUrl}/blog/${post.slug}`} class="card-link">
            <div class="card-content">
              {post.data.tags && (
                <div class="card-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag-badge">#{tag}</span>
                  ))}
                </div>
              )}
              <h3 class="card-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="card-desc">{post.data.description}</p>
              )}
              {post.data.date && (
                <span class="card-date">
                  {new Date(post.data.date).toLocaleDateString('ja-JP')}
                </span>
              )}
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1.5rem;
    background: #ffffff;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    margin-bottom: 3rem;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.25rem 0.85rem;
    background: #f1f5f9;
    color: #475569;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 9999px;
    margin-bottom: 1rem;
    border: 1px solid #cbd5e1;
  }

  .hero-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.4;
    margin-bottom: 0.85rem;
  }

  .hero-description {
    font-size: 0.975rem;
    color: #64748b;
    max-width: 580px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid #e2e8f0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .post-card {
    background: #ffffff;
    border-radius: 0.85rem;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    transition: all 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px -4px rgba(0, 0, 0, 0.06);
    border-color: #cbd5e1;
  }

  .card-link {
    text-decoration: none;
    color: inherit;
    display: block;
    padding: 1.35rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.65rem;
  }

  .tag-badge {
    font-size: 0.725rem;
    font-weight: 500;
    color: #475569;
    background: #f1f5f9;
    padding: 0.15rem 0.5rem;
    border-radius: 0.35rem;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.65;
    margin-bottom: 0.85rem;

    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    font-size: 0.775rem;
    color: #94a3b8;
    font-weight: 500;
  }
</style>
